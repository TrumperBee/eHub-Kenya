PORT=5000
FRONTEND_URL=http://localhost:5173
# Firebase user email with Command Center (admin) access — receives admin notifications
ADMIN_EMAIL=ochiengv250@gmail.com

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ZetuPay (M-Pesa STK Push) — active payment provider
# Secret key from the ZetuPay dashboard (sk_live_...). Server-side only.
# It authenticates the API and signs webhooks (x-zetupay-signature).
ZETUPAY_SECRET_KEY=
# Optional. Defaults to https://pay.zetupay.co.ke/api/v1
# ZETUPAY_BASE_URL=
# Optional. Webhooks are signed with the wallet's LIVE secret key even when the
# API is called with a test key. Set this if ZETUPAY_SECRET_KEY is a test key.
# ZETUPAY_WEBHOOK_SECRET=
# Optional collection channel id (e.g. 1001). Leave EMPTY unless the wallet
# settles into a specific paybill/till/bank; sending it for a wallet that
# settles with ZetuPay is rejected with 403.
# ZETUPAY_CHANNEL_ID=
# In the ZetuPay dashboard, set the Transaction Callback URL to:
#   https://<your-backend-host>/api/payment/zetupay/callback

# Paystack — DEPRECATED (kept for rollback; routes are no longer mounted)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_CALLBACK_URL=https://your-backend-url/api/payment/paystack/callback
# Webhook signatures used PAYSTACK_SECRET_KEY (HMAC-SHA512 of the raw body).

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=efootball-hub-images
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# AI (Google Gemini)
GEMINI_API_KEY=

# Email (Resend — transactional order & Friday Drop emails)
# The server uses these only for sending; nothing is ever emailed back to users
# containing account credentials, eHub passwords, or API keys.
RESEND_API_KEY=
# Bare sender address verified in your Resend dashboard
# (domain email like noreply@yourdomain.com, or onboarding@resend.dev for tests).
RESEND_FROM_EMAIL=
# Display name used for the sender address
RESEND_FROM_NAME=eHub Kenya
# Optional path to a local brand logo used by the PDF seller guide (absent -> text wordmark)
# EHUB_LOGO_PATH=

# Email (Nodemailer — legacy, unused; kept for reference)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
