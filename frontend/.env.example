VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_BACKEND_URL=http://localhost:5000
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Public Cloudflare R2 bucket origin (e.g. https://images.ehubmarket.me).
# Optional: only needed to repair legacy listing photos that were saved with the
# private *.r2.cloudflarestorage.com endpoint. Ignored when empty.
VITE_R2_PUBLIC_URL=
# Not used by the frontend — kept for reference / future use
VITE_ZETUPAY_PUBLIC_KEY=

# Web Push (optional override). The app fetches the VAPID public key from
# GET /api/push/public-key, so this is only needed for local debugging.
VITE_VAPID_PUBLIC_KEY=
